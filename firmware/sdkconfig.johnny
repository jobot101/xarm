# Johnny: shop helper, brain on the PC (pc.c). Layered on sdkconfig.defaults by CI.
CONFIG_XARM_JOHNNY=y
CONFIG_XARM_NAME="shop-mothership"
CONFIG_XARM_UPDATE_URL="https://jobot101.github.io/xarm/fw/johnny/"
# Eyes (eye.c): internal RAM was down to 12 KB free. WiFi/LWIP buffers go to PSRAM, the camera DMA buffer stays small.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192
# Real bell: solenoid striker on IO3 (bell.c), through a MOSFET (gate pull-down keeps it off through boot)
CONFIG_XARM_BELL_GPIO=3
# The camera's DMA buffers took the last internal RAM ("wifi:mem fail" -> abort 7 s after boot). On the S3, IRAM
# and heap share SRAM: keep WiFi/LWIP code in flash (a little slower, plenty for this) and trim WiFi's internal RX.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
# mmWave radar (Hi-Link) on IO7 (radar.c): presence output or serial, it tells which
CONFIG_XARM_RADAR_GPIO=7
# "ring the bell": the arm taps the chime that hangs above it (the solenoid stays on /api/bell for testing)
# CONFIG_XARM_BELL_ARM is not set (the solenoid is fixed at the chime: it does the ringing)
CONFIG_XARM_BELL_ABOVE=1
# Internal RAM squeeze (MotherShip): smaller system task stacks and WiFi/LWIP buffers; no BT; logs at INFO
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3072
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2560
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_MDNS_TASK_STACK_SIZE=3072
