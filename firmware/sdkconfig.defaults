CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8: 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# console over the board's USB-C (native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ESP-SR: English MultiNet7, no Chinese model, no WakeNet ("Hey Muffin" is a MultiNet phrase that opens a listening window)
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_SR_WN_WN9_HIESP=n
# VADNet: a trained voice detector in front of MultiNet (WebRTC VAD is the fallback if it's missing)
CONFIG_SR_VADN_VADNET1_MEDIUM=y

# OTA: a bad build that never calls esp_ota_mark_app_valid_cancel_rollback() reverts on reboot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_FREERTOS_HZ=1000

# TLS buffers (~40 KB per HTTPS connection: auto-update, voice bank, cloud ears) live in PSRAM, not the
# scarce internal RAM the AFE, WiFi and task stacks need
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# per-task CPU load for the Workshop System panel (/api/sys)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# TaskStatus_t.xCoreID for the System panel (web.c /api/sys)
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
